<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>UIAppFonts</key>
	<array>
		<string>Oswald-Regular.ttf</string>
		<string>Inter-Regular.ttf</string>
		<string>Cinzel-Bold.ttf</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(HEXBOUND_GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
	<key>HexboundEnvironment</key>
	<string>$(HEXBOUND_APP_ENV)</string>
	<key>HexboundAPIBaseURL</key>
	<string>$(HEXBOUND_API_BASE_URL)</string>
	<key>HexboundSupabaseProjectURL</key>
	<string>$(HEXBOUND_SUPABASE_PROJECT_URL)</string>
	<key>HexboundSupabaseAnonKey</key>
	<string>$(HEXBOUND_SUPABASE_ANON_KEY)</string>
	<key>HexboundGoogleClientID</key>
	<string>$(HEXBOUND_GOOGLE_CLIENT_ID)</string>
	<key>HexboundGoogleReversedClientID</key>
	<string>$(HEXBOUND_GOOGLE_REVERSED_CLIENT_ID)</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
