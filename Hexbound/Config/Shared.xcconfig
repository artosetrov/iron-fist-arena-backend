// Shared runtime config for all Hexbound iOS builds.
// Real values should come from Local.secrets.xcconfig, which is ignored by Git.

HEXBOUND_PRODUCTION_API_BASE_URL = __MISSING_PRODUCTION_API_BASE_URL__
HEXBOUND_STAGING_API_BASE_URL = __MISSING_STAGING_API_BASE_URL__
HEXBOUND_SUPABASE_PROJECT_URL = __MISSING_SUPABASE_PROJECT_URL__
HEXBOUND_SUPABASE_ANON_KEY = __MISSING_SUPABASE_ANON_KEY__
HEXBOUND_GOOGLE_CLIENT_ID = __MISSING_GOOGLE_CLIENT_ID__
HEXBOUND_GOOGLE_REVERSED_CLIENT_ID = __MISSING_GOOGLE_REVERSED_CLIENT_ID__

#include? "Local.secrets.xcconfig"
