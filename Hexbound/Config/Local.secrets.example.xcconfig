// Copy this file to Local.secrets.xcconfig and fill in the real values.
// This file is intentionally kept out of source control.

// Important: avoid literal `//` in xcconfig values. Use $(HEXBOUND_URL_SLASH) instead.
HEXBOUND_PRODUCTION_API_BASE_URL = https:$(HEXBOUND_URL_SLASH)$(HEXBOUND_URL_SLASH)api.hexboundapp.com
HEXBOUND_STAGING_API_BASE_URL = https:$(HEXBOUND_URL_SLASH)$(HEXBOUND_URL_SLASH)staging-api.hexboundapp.com

HEXBOUND_SUPABASE_PROJECT_URL = https:$(HEXBOUND_URL_SLASH)$(HEXBOUND_URL_SLASH)your-project.supabase.co
HEXBOUND_SUPABASE_ANON_KEY = your-supabase-anon-key

HEXBOUND_GOOGLE_CLIENT_ID = your-google-client-id.apps.googleusercontent.com
HEXBOUND_GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.your-google-client-id
