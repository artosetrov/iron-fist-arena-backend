def app_store_connect_api_key_from_env
  key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"].to_s.strip
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"].to_s.strip
  key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"].to_s.strip
  key_content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"].to_s.strip
  key_content_base64 = ENV["APP_STORE_CONNECT_API_KEY_CONTENT_BASE64"].to_s.strip

  has_key_material = !key_path.empty? || !key_content.empty? || !key_content_base64.empty?
  has_any_api_key_env = !key_id.empty? || !issuer_id.empty? || has_key_material
  return nil unless has_any_api_key_env

  missing = []
  missing << "APP_STORE_CONNECT_API_KEY_ID" if key_id.empty?
  missing << "APP_STORE_CONNECT_ISSUER_ID" if issuer_id.empty?
  missing << "APP_STORE_CONNECT_API_KEY_PATH or APP_STORE_CONNECT_API_KEY_CONTENT(_BASE64)" unless has_key_material
  UI.user_error!("App Store Connect API key auth is incomplete: #{missing.join(', ')}.") unless missing.empty?

  if !key_path.empty? && (!key_content.empty? || !key_content_base64.empty?)
    UI.user_error!("Use either APP_STORE_CONNECT_API_KEY_PATH or APP_STORE_CONNECT_API_KEY_CONTENT(_BASE64), not both.")
  end

  options = {
    key_id: key_id,
    issuer_id: issuer_id
  }

  if !key_path.empty?
    options[:key_filepath] = key_path
  elsif !key_content_base64.empty?
    options[:key_content] = key_content_base64
    options[:is_key_content_base64] = true
  else
    options[:key_content] = key_content
  end

  app_store_connect_api_key(**options)
end

def require_release_identity!
  api_key = app_store_connect_api_key_from_env
  return { auth_mode: :app_store_connect_api_key, api_key: api_key } if api_key

  apple_id_value = CredentialsManager::AppfileConfig.try_fetch_value(:apple_id)
  team_id_value = CredentialsManager::AppfileConfig.try_fetch_value(:team_id)
  itc_team_id_value = CredentialsManager::AppfileConfig.try_fetch_value(:itc_team_id)

  missing = []
  missing << "apple_id" if apple_id_value.to_s.strip.empty?
  if team_id_value.to_s.strip.empty? && itc_team_id_value.to_s.strip.empty?
    missing << "team_id or itc_team_id"
  end

  return { auth_mode: :apple_id, api_key: nil } if missing.empty?
  UI.user_error!(
    "Fastlane release identity is incomplete: #{missing.join(', ')}. " \
    "Use App Store Connect API key env vars, FASTLANE_* env vars, or fastlane/Appfile.local."
  )
end

def run_ios_release_preflight!
  sh("python3 scripts/check_release_config.py")
end

default_platform(:ios)

platform :ios do
  before_all do |lane, _options|
    next unless [:beta, :build].include?(lane)

    run_ios_release_preflight!
  end

  # ──────────────────────────────────────────────
  # ЗАГРУЗИТЬ НА TESTFLIGHT
  # Запуск: fastlane beta
  # ──────────────────────────────────────────────
  desc "Собрать и загрузить на TestFlight"
  lane :beta do
    auth = require_release_identity!

    # 1. Инкрементировать build number
    increment_build_number(
      xcodeproj: "Hexbound.xcodeproj"
    )

    # 2. Собрать архив
    build_app(
      project: "Hexbound.xcodeproj",
      scheme: "Hexbound",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "Hexbound.ipa",
      clean: true,
      include_symbols: true,
      export_options: {
        provisioningProfiles: {
          "com.hexbound.app" => "Hexbound AppStore"
        }
      }
    )

    # 3. Загрузить на App Store Connect / TestFlight
    upload_options = {
      skip_waiting_for_build_processing: true,
      notify_external_testers: false,
      changelog: "Новый билд Hexbound 🎮"
    }
    upload_options[:api_key] = auth[:api_key] if auth[:api_key]
    upload_to_testflight(**upload_options)

    # 4. Уведомить об успехе
    current_version = get_version_number(xcodeproj: "Hexbound.xcodeproj")
    current_build = get_build_number(xcodeproj: "Hexbound.xcodeproj")
    auth_label = auth[:auth_mode] == :app_store_connect_api_key ? "ASC API key" : "Apple ID session"
    UI.success("✅ Hexbound #{current_version} (#{current_build}) загружен на TestFlight! Auth: #{auth_label}")
  end

  # ──────────────────────────────────────────────
  # ТОЛЬКО СОБРАТЬ (без загрузки)
  # Запуск: fastlane build
  # ──────────────────────────────────────────────
  desc "Собрать без загрузки (проверка что компилится)"
  lane :build do
    build_app(
      project: "Hexbound.xcodeproj",
      scheme: "Hexbound",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "Hexbound.ipa",
      clean: true
    )
    UI.success("✅ Билд собран: ./build/Hexbound.ipa")
  end

  # ──────────────────────────────────────────────
  # ИНКРЕМЕНТ ВЕРСИИ
  # Запуск: fastlane bump_patch / bump_minor / bump_major
  # ──────────────────────────────────────────────
  desc "Bump patch версию (1.0.0 → 1.0.1)"
  lane :bump_patch do
    increment_version_number(
      xcodeproj: "Hexbound.xcodeproj",
      bump_type: "patch"
    )
    version = get_version_number(xcodeproj: "Hexbound.xcodeproj")
    UI.success("Версия: #{version}")
  end

  desc "Bump minor версию (1.0.x → 1.1.0)"
  lane :bump_minor do
    increment_version_number(
      xcodeproj: "Hexbound.xcodeproj",
      bump_type: "minor"
    )
    version = get_version_number(xcodeproj: "Hexbound.xcodeproj")
    UI.success("Версия: #{version}")
  end

  desc "Bump major версию (1.x.x → 2.0.0)"
  lane :bump_major do
    increment_version_number(
      xcodeproj: "Hexbound.xcodeproj",
      bump_type: "major"
    )
    version = get_version_number(xcodeproj: "Hexbound.xcodeproj")
    UI.success("Версия: #{version}")
  end

  # ──────────────────────────────────────────────
  # ERROR HANDLING
  # ──────────────────────────────────────────────
  error do |lane, exception|
    UI.error("❌ Ошибка в lane '#{lane}': #{exception.message}")
  end
end
