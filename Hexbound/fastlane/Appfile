# Hexbound — Fastlane Config
# Source of truth: docs/10_operations/RELEASE_IOS.md

# App Identifier (must match Xcode bundle ID)
app_identifier("com.hexbound.app")

local_appfile = File.join(__dir__, "Appfile.local")
eval(File.read(local_appfile), binding, local_appfile) if File.exist?(local_appfile)

# CI / secure local overrides should come from environment variables and win over Appfile.local.
apple_id(ENV["FASTLANE_APPLE_ID"]) if ENV["FASTLANE_APPLE_ID"]
team_id(ENV["FASTLANE_TEAM_ID"]) if ENV["FASTLANE_TEAM_ID"]
itc_team_id(ENV["FASTLANE_ITC_TEAM_ID"]) if ENV["FASTLANE_ITC_TEAM_ID"]

# `Appfile.local.example` shows the expected local format.
