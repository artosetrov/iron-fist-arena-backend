# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://gqnyozmqbhgzprsftdzp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.ref:password@aws-0-region.pooler.supabase.com:5432/postgres

# App / frontend integration
NEXT_PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Feature flags
INTERACTIVE_COMBAT_V1=false

# Shared KV / rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Internal service secrets
BOT_TICKET_SECRET=

# Apple (IAP & Push)
APPLE_BUNDLE_ID=
APPLE_IAP_ENVIRONMENT=sandbox
# Prefer APPLE_IAP_PRIVATE_KEY_PATH locally so the .p8 stays out of env files / git.
# In hosted environments (Vercel, CI), inject APPLE_IAP_PRIVATE_KEY as a secret instead.
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_PRIVATE_KEY_PATH=../User/Key/SubscriptionKey_LOCAL_ONLY.p8
APPLE_SHARED_SECRET=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY=
APNS_BEARER_TOKEN=
APNS_BUNDLE_ID=
